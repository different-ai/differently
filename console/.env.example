# Static mode (default): nothing is required. Optionally preset the server URL
# shown on the connect screen:
# PUBLIC_DIFFERENTLY_URL=https://differently.example.com
# Serve under a subpath instead of the site root:
# CONSOLE_BASE=/console/

# Development: where the dev server forwards /v1 (static) or the proxy goes (server).
DIFFERENTLY_URL=http://localhost:8080

# Server mode (CONSOLE_MODE=server). The key the console server uses for
# everyone who signs in; never sent to browsers.
# CONSOLE_MODE=server
# DIFFERENTLY_API_KEY=dly_...
# BETTER_AUTH_SECRET=   # openssl rand -base64 32
# BETTER_AUTH_URL=http://localhost:4321
# CONSOLE_ALLOWED_EMAILS=you@example.com,teammate@example.com
# CONSOLE_DB_PATH=./console.db
# Where `npm start` listens:
# HOST=0.0.0.0
# PORT=4321
# Optional GitHub sign-in:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
