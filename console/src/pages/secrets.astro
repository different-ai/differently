---
import Console from '../layouts/Console.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
---
<Console title="Secrets" active="secrets">
  <PageHeader title="Secrets" description="Provider keys stored sealed in Differently. Values are never shown again.">
    <button class="btn primary" type="button" data-open="put"><Icon name="plus" size={15} />Add secret</button>
  </PageHeader>
  <div id="list"></div>

  <dialog class="modal" id="put">
    <form>
      <div class="modal-head"><h2>Store a secret</h2><button class="btn ghost icon-btn" type="button" data-close aria-label="Close"><Icon name="x" /></button></div>
      <label class="field"><span>Name</span><input type="text" name="name" required pattern="[a-z0-9][a-z0-9._-]{0,62}" placeholder="e.g. daytona-key" /><small>Storing an existing name replaces its value; pools using it pick up the new one.</small></label>
      <label class="field"><span>Value</span><input type="password" name="value" required autocomplete="off" /></label>
      <div class="modal-foot"><button class="btn" type="button" data-close>Close</button><button class="btn primary" data-save>Save</button></div>
    </form>
  </dialog>
</Console>
<script>
  import { client } from '../lib/connection';
  import { confirmAction, dialog, el, empty, field, relTime, rowMenu, section, table, toast } from '../lib/ui';
  import type { Secret } from '@differently/sdk';

  const c = client();
  async function load() {
    await section('#list', async () => table<Secret>([
      { label: 'Name', cell: (s) => el('span', { class: 'mono', style: 'font-weight:500' }, s.name) },
      { label: 'Fingerprint', cell: (s) => el('span', { class: 'mono muted' }, s.fingerprint) },
      { label: 'Used by', cell: (s) => s.usedBy.length ? el('span', {}, ...s.usedBy.map((p) => el('span', { class: 'chip' }, p))) : el('span', { class: 'muted' }, 'Unused') },
      { label: 'Updated', cell: (s) => el('span', { class: 'muted' }, `${relTime(s.updatedAt)} by ${s.updatedBy}`) },
      { label: '', className: 'actions', cell: (s) => rowMenu([
        { label: 'Delete', danger: true, hidden: s.usedBy.length > 0, run: async () => { if (await confirmAction(`Delete ${s.name}?`, 'The value is erased and cannot be recovered.', 'Delete')) { await c.admin.secrets.delete(s.name); toast('Deleted'); await load(); } } },
      ]) },
    ], await c.admin.secrets.list(), empty('No secrets stored. Provider keys added with a provider are saved here.', ['key', 'lock'])));
  }
  dialog('put', async (form) => { await c.admin.secrets.put(field(form, 'name'), String(new FormData(form).get('value') ?? '')); toast('Saved'); await load(); });
  void load();
</script>
