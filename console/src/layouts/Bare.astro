---
import '../styles/console.css';
import { logo } from '../lib/icons';
interface Props { title: string }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Differently</title>
    <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
    <script is:inline>
      try { const t = localStorage.getItem('differently.theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <div class="center">
      <div class="card">
        <a class="brand" href={base}><Fragment set:html={logo} />Differently</a>
        <slot />
      </div>
    </div>
  </body>
</html>
