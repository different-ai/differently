---
import '../styles/landing.css';
import { Code } from 'astro:components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/different-ai/differently';
const releases = `${repo}/releases`;
const version = 'v0.1.0-alpha.1';

// Launch video slot. Set videoSrc to a video URL (and optionally a poster image and a
// WebVTT captions file) to show it under the hero. While videoSrc is '' nothing renders.
// The video is silent; its figcaption summarises what it shows.
const videoSrc: string = `${base}/media/differently-intro.mp4`;
const videoPoster: string = `${base}/media/differently-intro-poster.jpg`;
const videoCaptions: string = '';
const videoTitle = 'A 36-second overview: private work stays on OpenSandbox, and overflows to an external provider only when policy allows it.';

const samples = [
  {
    id: 'ts',
    label: 'TypeScript',
    lang: 'ts',
    code: `import { Differently } from "@differently/sdk";

const differently = new Differently({ apiKey: process.env.DIFFERENTLY_API_KEY });

// Request a size and a placement policy, not a backend.
const sandbox = await differently.sandboxes.create({
  profile: "small",
  placement: { strategy: "private-first", external: "never" },
});

const result = await sandbox.exec("node --version");
console.log(result.exitCode, result.stdout);

await sandbox.files.write("/work/a.txt", "hi");
await sandbox.delete();`,
  },
  {
    id: 'py',
    label: 'Python',
    lang: 'python',
    code: `from differently import Differently

client = Differently()  # DIFFERENTLY_API_KEY, DIFFERENTLY_URL

# A sandbox is a context manager that deletes itself on exit.
with client.sandboxes.create(
    profile="small",
    placement={"strategy": "private-first", "external": "never"},
) as sandbox:
    result = sandbox.exec("python3 --version")
    print(result.exit_code, result.stdout)

    for ev in sandbox.exec_stream("make test"):
        print(ev.type, getattr(ev, "data", ""))`,
  },
  {
    id: 'cli',
    label: 'CLI',
    lang: 'sh',
    code: `differently doctor
differently sandbox create --profile small --wait
differently sandbox exec sbx_123 -- 'echo hello from $(uname -s)'
differently sandbox files put sbx_123 ./README.md /work/README.md

# Why a sandbox was placed where it runs
differently sandbox placement sbx_123

# Operator view: endpoints, credentials and external placements
differently admin trust-report`,
  },
];

// Ways to run it, friendliest first. Status comes from what has actually run:
// 'verified' = ran end to end; 'documented' = written steps, not yet among those runs.
const ways = [
  {
    title: 'Laptop',
    what: 'Dev mode: an in-memory server with a devhost pool that runs commands directly on the host, with no isolation. For trying the API.',
    status: 'Verified',
    kind: 'verified',
    href: `${base}/docs/guides/quickstart/`,
    cta: 'Laptop quickstart',
  },
  {
    title: 'Any Docker host',
    what: 'Postgres, Differently and OpenSandbox as one Docker stack. Sandboxes are containers sharing the host kernel.',
    cmd: 'make e2e-prepare e2e-up',
    status: 'Verified',
    kind: 'verified',
    href: `${repo}/tree/pre-release/test/e2e`,
    cta: 'Docker stack on GitHub',
  },
  {
    title: 'One Linux VM',
    where: 'AWS · Google Cloud · Azure · bare metal',
    what: "k3s with OpenSandbox's charts and Differently's chart on a single machine.",
    detail: 'Tested on Azure. The steps for AWS EC2, Google Compute Engine and bare metal are the same and have not been run yet.',
    status: 'Verified on Azure',
    kind: 'verified',
    href: `${base}/docs/deploy/single-vm/`,
    cta: 'Single-VM guide',
  },
  {
    title: 'Existing Kubernetes',
    where: 'EKS · GKE · AKS · k3s · RKE2',
    what: 'Install the Helm chart on an existing cluster, next to an OpenSandbox server.',
    status: 'Documented',
    kind: 'documented',
    href: `${base}/docs/deploy/kubernetes/`,
    cta: 'Kubernetes guide',
  },
  {
    title: 'Air-gapped',
    what: 'Mirror the images and chart into a private registry. No telemetry, no phone-home.',
    status: 'Documented',
    kind: 'documented',
    href: `${base}/docs/deploy/air-gapped/`,
    cta: 'Air-gapped guide',
  },
];

// Project status. verified: ran against real infrastructure. notVerified: not run yet.
const verified = [
  ['End-to-end suite', "14 of 14 tests pass on OpenSandbox's Docker runtime (arm64) and its Kubernetes runtime (single-node k3s on Azure, installed with Helm)."],
  ['Kubernetes runtime', 'Stop/start with the disk kept, snapshots and fork through a snapshot registry, signed port URLs including WebSockets, and egress policy.'],
  ['Idle auto-stop', 'Idle sandboxes stop (Kubernetes) or pause (Docker) and wake on the next call.'],
  ['Release artifacts', 'The published chart and images install from public registries; the first sandbox runs in about 2 s.'],
  ['Recorded runtimes', 'Real OpenSandbox responses from both runtimes are replayed in every go test.'],
  ['OpenWork', 'Workbot computers run through Differently as a sandbox gateway, behind a flag: commands with Python tools, files, and stop/start.'],
  ['Failure isolation', 'An image that cannot be pulled fails that sandbox only; the shared pool stays healthy.'],
  ['agent-sandbox', 'The adapter runs against a Kubernetes cluster (kind, runc).'],
];
const notVerified = [
  'Fast Sandbox microVMs: runtime support is merged, live testing is in progress',
  'Multi-node clusters and node drains',
  'Managed EKS, GKE and AKS clusters',
  'Managed-provider adapters against live accounts; each is tested against a fake of its published API',
];
const inProgress: string[] = [];

const tryIt = `make build
./bin/differently-server --dev

# in a second terminal
./bin/differently sandbox create --profile small --wait`;

const features = [
  {
    k: '01',
    title: 'Provider adapters',
    body: '16 built-in adapters, from self-hosted OpenSandbox to E2B, Vercel and the AWS, Azure and Google Cloud sandbox services, plus a plugin protocol for any other backend. Operators change where work goes; applications keep the same API.',
    href: '/docs/providers/',
    cta: 'Provider catalog',
  },
  {
    k: '02',
    title: 'Quotas and policy-gated overflow',
    body: 'Registering a managed provider does not authorize its use. Work goes to an external pool only when global, organization and project policy, the data classification and the request all allow it. Quotas are derived from state and enforced at admission; ambiguous cases are denied.',
    href: '/docs/guides/hybrid-overflow/',
    cta: 'Hybrid overflow guide',
  },
  {
    k: '03',
    title: 'Placement explanations',
    body: 'Each placement records the pools considered, the ones excluded and why, and how the rest were ranked. One API call returns the explanation for any sandbox.',
    href: '/docs/scheduling/placement-policy/',
    cta: 'Placement policy',
  },
  {
    k: '04',
    title: 'Trust report',
    body: 'One report of external endpoints, credentials by reference, external placements, admin actions, audit chain status, and the properties Differently cannot verify itself.',
    href: '/docs/security/trust-model/',
    cta: 'Security and trust model',
  },
];

const fromRuntime = [
  ['Sandbox runtimes', 'Docker, Kubernetes, and Fast Sandbox (Firecracker microVMs on a per-node agent).'],
  ['Lifecycle', 'Create and delete; pause and resume on Docker; stop and start on Kubernetes; a provider-side timeout as a TTL backstop.'],
  ['Exec and files', 'Commands with env, cwd, timeouts and streamed output; upload, download and list files.'],
  ['Snapshots', 'Disk snapshots and fork on Docker and Kubernetes; memory snapshots on Fast Sandbox (documented upstream, not yet tested).'],
  ['Open source', 'Apache-2.0, self-hostable, with SDKs in several languages.'],
];
const added = [
  ['Multi-tenancy', 'Organizations, projects and scoped API keys. OpenSandbox has one server-wide key.'],
  ['Quotas and fair queueing', 'Usage derived from state, enforced at admission, queued fairly across tenants.'],
  ['Policy-gated placement', 'Global, org and project policy plus data classification decide which pool may run each sandbox. External pools fail closed.'],
  ['Many backends, one API', '16 built-in provider adapters and plugins behind one contract and one SDK.'],
  ['Placement explanations', 'Every decision records the pools considered, the ones rejected and why.'],
  ['Audit and trust report', 'A tamper-evident audit chain and one report of endpoints, credentials by reference, external placements and limits.'],
];
const compare = [
  ['Where sandboxes can run', 'One runtime or one vendor', 'Every registered pool, chosen per request'],
  ['When a pool is full or down', 'Wait, fail, or change application code', 'Queue, or overflow to a pool policy allows'],
  ['Switching providers', 'Change SDKs and application code', 'Change placement policy; code stays the same'],
  ['Who may use external capacity', 'Whoever holds the key', 'Only tenants, classifications and requests policy allows'],
  ['Tenancy and quotas', 'Per vendor account, or none', 'Orgs, projects, scoped keys and quotas across all pools'],
  ['Knowing where work ran', 'Each provider\'s own logs', 'One placement record, audit chain and trust report'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Differently · Open-source sandbox orchestration</title>
    <meta name="description" content="Open-source, self-hosted control plane for sandboxes: one API, quotas, policy-based placement and audit across OpenSandbox, 15 more provider adapters and plugins." />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const t = localStorage.getItem('starlight-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <div class="status" role="note">
      <strong>Pre-release.</strong> {version} is an alpha release, not intended for production use.
      <a href="#status">Project status</a>
    </div>

    <header class="nav wrap">
      <a class="brand" href={`${base}/`}>
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="10" y="3" width="19" height="19" rx="4" fill="none" stroke="currentColor" stroke-width="2.5"/><rect x="3" y="10" width="19" height="19" rx="4" fill="currentColor"/></svg>
        Differently
      </a>
      <nav>
        <a href="#stack">Features</a>
        <a href={`${base}/docs/`}>Docs</a>
        <a href={`${base}/docs/reference/api/`}>API</a>
        <a href={repo}>GitHub</a>
        <button class="theme" type="button" aria-label="Toggle color theme">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" /></svg>
        </button>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <a class="pill" href={releases}>{version} · pre-release<span class="sr-only">: release notes on GitHub</span></a>
        <p class="eyebrow">Open source · Apache-2.0 · Self-hosted orchestration</p>
        <h1>Everyone builds sandboxes.<br /><em>We orchestrate them.</em></h1>
        <p class="lede">
          Differently is an open-source control plane for sandboxes. It runs on any cloud or on bare metal
          and places each sandbox on OpenSandbox, E2B, Daytona, a cloud provider's sandbox service or a plugin,
          according to placement policy. Applications use one API; quotas, placement decisions and audit live in the control plane.
        </p>
        <div class="ctas">
          <a class="btn primary" href={`${base}/docs/guides/quickstart/`}>Get started</a>
          <a class="btn" href={`${base}/docs/deploy/`}>Deploy it</a>
          <a class="btn" href={repo}>View on GitHub</a>
        </div>
        <div class="install">
          <span>$</span><code>helm install differently deploy/helm/differently</code>
        </div>
        <ul class="pillars">
          <li><b>One API.</b> Applications request resources and capabilities, not a backend.</li>
          <li><b>Many backends.</b> Self-hosted runtimes and managed providers behind one adapter contract.</li>
          <li><b>Policy and audit.</b> Quotas, placement rules and a tamper-evident audit log.</li>
        </ul>

        {/* Launch video slot. Renders only when videoSrc (top of this file) is non-empty. */}
        {videoSrc && (
          <figure class="video" id="video">
            <video controls preload="metadata" playsinline poster={videoPoster || undefined} aria-label={videoTitle}>
              <source src={videoSrc} />
              {videoCaptions && <track kind="captions" src={videoCaptions} srclang="en" label="English" default />}
            </video>
            <figcaption>{videoTitle}</figcaption>
          </figure>
        )}
      </section>

      <section class="how wrap" id="how">
        <div class="section-head">
          <p class="eyebrow">How it works</p>
          <h2>Policy-based placement</h2>
          <p>Requests are admitted against quota and queued. One elected scheduler checks every registered pool against global, organization and project policy, ranks the eligible pools and records the decision. Adapters then create the sandbox on a self-hosted OpenSandbox server or, where policy allows, on an external provider.</p>
        </div>
        <figure class="diagram">
          <svg viewBox="0 0 960 360" role="img" aria-labelledby="dtitle">
            <title id="dtitle">Applications call differently-server, which stores state in Postgres and places sandboxes on self-hosted OpenSandbox servers, or on external providers only when policy allows.</title>
            <defs>
              <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="ah" /></marker>
            </defs>
            <rect class="zone" x="190" y="16" width="560" height="328" rx="18" />
            <text class="zone-label" x="210" y="44">SELF-HOSTED · OPERATOR-HELD KEYS</text>

            <g class="node"><rect x="16" y="140" width="140" height="80" rx="12" /><text x="86" y="174">App · SDK</text><text x="86" y="196" class="sub">CLI · dashboard</text></g>
            <g class="node strong"><rect x="230" y="120" width="190" height="120" rx="12" /><text x="325" y="160">differently-server</text><text x="325" y="184" class="sub">API · auth · quotas</text><text x="325" y="204" class="sub">audit · scheduler leader</text></g>
            <g class="node"><rect x="260" y="270" width="130" height="56" rx="12" /><text x="325" y="304">Postgres</text></g>
            <g class="node"><rect x="490" y="64" width="230" height="84" rx="12" /><text x="605" y="98">OpenSandbox</text><text x="605" y="122" class="sub">Docker · Kubernetes runtime</text></g>
            <g class="node"><rect x="490" y="176" width="230" height="84" rx="12" /><text x="605" y="210">OpenSandbox</text><text x="605" y="234" class="sub">Fast Sandbox microVMs</text></g>
            <g class="node ext"><rect x="790" y="140" width="154" height="80" rx="12" /><text x="867" y="174">Providers</text><text x="867" y="196" class="sub">E2B · Daytona · cloud</text></g>

            <path class="edge" d="M156 180H226" marker-end="url(#arr)" />
            <text class="elabel" x="191" y="166">one API</text>
            <path class="edge" d="M325 240V266" marker-end="url(#arr)" />
            <path class="edge" d="M420 160C455 160 455 106 486 106" marker-end="url(#arr)" />
            <path class="edge" d="M420 200C455 200 455 218 486 218" marker-end="url(#arr)" />
            <path class="edge ext" d="M420 228C600 300 760 270 786 200" marker-end="url(#arr)" />
                        <text class="elabel ext" x="640" y="316">only if every policy allows</text>
          </svg>
        </figure>
        <ol class="steps">
          <li><b>Request.</b> A client asks for a profile, capabilities and a placement policy.</li>
          <li><b>Filter and rank.</b> Pools that fail a rule are excluded with a reason; the rest are ranked.</li>
          <li><b>Run and record.</b> The sandbox is created; the decision, usage and audit events are stored.</li>
        </ol>
      </section>

      <section class="deploy wrap" id="deploy">
        <div class="section-head">
          <p class="eyebrow">Deployment</p>
          <h2>Deployment options</h2>
          <p>From a laptop to an air-gapped cluster. <b>Verified</b> options have run end to end; <b>Documented</b> options have written steps that have not been run end to end yet.</p>
        </div>
        <div class="ways">
          {ways.map((w) => (
            <article>
              <div class="way-head">
                <h3>{w.title}</h3>
                <span class={`chip ${w.kind}`}>{w.status}</span>
              </div>
              {w.where && <p class="where">{w.where}</p>}
              <p>{w.what}</p>
              {w.cmd && <p><code>{w.cmd}</code></p>}
              {w.detail && <p class="detail">{w.detail}</p>}
              <a href={w.href}>{w.cta} →</a>
            </article>
          ))}
          <article class="aside">
            <h3>Requirements</h3>
            <p>Control-plane requirements, the OpenSandbox server, network ports, and KVM hosts for Fast Sandbox microVMs.</p>
            <a href={`${base}/docs/deploy/prerequisites/`}>Prerequisites →</a>
          </article>
        </div>
      </section>

      <section class="stack wrap" id="stack">
        <div class="section-head">
          <p class="eyebrow">Features</p>
          <h2>Built on OpenSandbox</h2>
          <p>Differently does not include a sandbox runtime. Its default private runtime is <a href="https://github.com/opensandbox-group/OpenSandbox">OpenSandbox</a>, run by the operator. Differently adds multi-tenancy, quotas, placement policy and audit across every connected pool.</p>
        </div>
        <div class="split">
          <div>
            <h3>From OpenSandbox</h3>
            <dl>{fromRuntime.map(([t, d]) => (<><dt>{t}</dt><dd>{d}</dd></>))}</dl>
          </div>
          <div>
            <h3>Added by Differently</h3>
            <dl>{added.map(([t, d]) => (<><dt>{t}</dt><dd>{d}</dd></>))}</dl>
          </div>
        </div>
        <h3 class="compare-title">Compared with a single provider</h3>
        <div class="compare">
          <table>
            <thead><tr><th></th><th>Single provider</th><th>Differently</th></tr></thead>
            <tbody>{compare.map(([q, a, b]) => (<tr><th scope="row">{q}</th><td>{a}</td><td>{b}</td></tr>))}</tbody>
          </table>
        </div>
        <p class="note">Support per backend: the <a href={`${base}/docs/providers/`}>provider catalog</a>, <a href={`${base}/docs/features/`}>Features</a> and <a href={`${base}/docs/feature-parity/`}>feature parity</a>.</p>
      </section>

      <section class="code wrap" id="code">
        <div class="section-head">
          <p class="eyebrow">SDKs and CLI</p>
          <h2>TypeScript, Python, Go and a CLI</h2>
          <p>Thin clients of one <a href={`${base}/docs/reference/api/`}>OpenAPI contract</a>: exec, streamed output, files, snapshots, fork and ports, where the placed backend supports them.</p>
        </div>
        <div class="tabs" role="tablist">
          {samples.map((s, i) => (
            <button role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${s.id}`} id={`tab-${s.id}`}>{s.label}</button>
          ))}
        </div>
        {samples.map((s, i) => (
          <div class="panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
            <Code code={s.code} lang={s.lang as any} themes={{ light: 'github-light', dark: 'github-dark' }} />
          </div>
        ))}
        <p class="note">To run these locally, see <a href="#start">Get started</a>.</p>
      </section>

      <section class="features wrap" id="features">
        <div class="section-head">
          <p class="eyebrow">Capabilities</p>
          <h2>Control plane capabilities</h2>
        </div>
        <div class="grid">
          {features.map((f) => (
            <article>
              <span class="k">{f.k}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
              <a href={`${base}${f.href}`}>{f.cta} →</a>
            </article>
          ))}
        </div>
      </section>

      <section class="honest wrap" id="status">
        <div>
          <p class="eyebrow">Project status · {version}</p>
          <h2>Tested on real infrastructure</h2>
        </div>
        <div class="cols">
          <div>
            <h3>Verified</h3>
            <ul>{verified.map(([t, d]) => <li><b>{t}.</b> {d}</li>)}</ul>
          </div>
          <div>
            <h3>Not yet verified</h3>
            <ul>{notVerified.map((v) => <li>{v}</li>)}</ul>
          </div>
          {inProgress.length > 0 && (
            <div>
              <h3>In progress, not merged</h3>
              <ul>{inProgress.map((v) => <li>{v}</li>)}</ul>
            </div>
          )}
        </div>
        <p class="note">Details: the <a href={`${base}/docs/deploy/`}>support matrix</a>, <a href={`${base}/docs/providers/`}>provider catalog</a>, <a href={`${base}/docs/security/hardening-checklist/`}>hardening checklist</a>, <a href={`${base}/docs/proof-of-concepts/`}>proofs of concept</a> and the <a href={`${base}/docs/feature-parity/`}>feature parity</a> table.</p>
      </section>

      <section class="start wrap" id="start">
        <div class="section-head">
          <p class="eyebrow">Get started</p>
          <h2>Run it locally</h2>
          <p>From a clone of <a href={repo}>the repository</a>:</p>
        </div>
        <div class="panel">
          <Code code={tryIt} lang="sh" themes={{ light: 'github-light', dark: 'github-dark' }} />
        </div>
        <p class="warn"><strong>Dev mode has no isolation.</strong> State is kept in memory and the devhost pool runs commands directly on the host as the current user. Use it to try the API, not for untrusted code.</p>
        <div class="next">
          <a href={`${base}/docs/deploy/single-vm/`}>
            <b>Deploy on one Linux VM →</b>
            <span>k3s, OpenSandbox and Differently on AWS, Google Cloud, Azure or bare metal.</span>
          </a>
          <a href={`${base}/docs/deploy/kubernetes/`}>
            <b>Install with Helm →</b>
            <span>On an existing Kubernetes cluster: EKS, GKE, AKS, k3s or RKE2.</span>
          </a>
        </div>
      </section>

      <section class="cta wrap">
        <h2>Run sandboxes differently.</h2>
        <p>Apache-2.0, developed in the open by the OpenWork team. Issues and pull requests are welcome.</p>
        <div class="ctas">
          <a class="btn primary" href={`${base}/docs/`}>Browse the docs</a>
          <a class="btn" href={repo}>Star on GitHub</a>
        </div>
      </section>
    </main>

    <footer class="wrap">
      <span>Differently · Apache-2.0 · by <a href="https://github.com/different-ai">OpenWork</a></span>
      <span><a href={releases}>Releases</a> · <a href={`${repo}/blob/pre-release/SECURITY.md`}>Security policy</a></span>
    </footer>

    <script>
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      tabs.forEach((tab) =>
        tab.addEventListener('click', () => {
          tabs.forEach((t) => {
            const on = t === tab;
            t.setAttribute('aria-selected', String(on));
            document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
          });
        }),
      );
      document.querySelector('.theme')!.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('starlight-theme', next); } catch {}
      });
    </script>
  </body>
</html>
