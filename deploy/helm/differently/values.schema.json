{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Differently Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "registry": {"type": "string"},
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": ["string", "number"]},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "k8sObject": {"type": "object"},
    "k8sList": {"type": "array"},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "externalMode": {"type": "string", "enum": ["never", "overflow", "allowed"]},
    "strategy": {"type": "string", "enum": ["private-first", "cost", "spread"]},
    "nonNegativeInt": {"type": "integer", "minimum": 0},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"type": "integer", "minimum": 0},
        "memoryMiB": {"type": "integer", "minimum": 0},
        "diskGiB": {"type": "integer", "minimum": 0}
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxActiveSandboxes": {"$ref": "#/definitions/nonNegativeInt"},
        "maxQueued": {"$ref": "#/definitions/nonNegativeInt"},
        "maxCPU": {"$ref": "#/definitions/nonNegativeInt"},
        "maxMemoryMiB": {"$ref": "#/definitions/nonNegativeInt"},
        "maxDiskGiB": {"$ref": "#/definitions/nonNegativeInt"},
        "maxTTLSeconds": {"$ref": "#/definitions/nonNegativeInt"},
        "maxSnapshots": {"$ref": "#/definitions/nonNegativeInt"},
        "poolBudgetsPerHour": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
      }
    },
    "costModel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {"type": "string"},
        "cpuHour": {"type": "number", "minimum": 0},
        "memoryGiBHour": {"type": "number", "minimum": 0},
        "diskGiBHour": {"type": "number", "minimum": 0},
        "sandboxHour": {"type": "number", "minimum": 0}
      }
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "adapter"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "enum": ["opensandbox", "remote", "daytona", "freestyle", "fake", "vercel", "fly", "agent-sandbox", "cubesandbox", "aws-agentcore", "azure-sandboxes", "azure-sessions", "gcp-sandboxes", "northflank", "boat", "e2b", "morph", "blaxel"]},
        "trust": {"type": "string", "enum": ["private", "external"]},
        "region": {"type": "string"},
        "labels": {"$ref": "#/definitions/stringMap"},
        "enabled": {"type": "boolean"},
        "maxConcurrency": {"$ref": "#/definitions/nonNegativeInt"},
        "costModel": {"$ref": "#/definitions/costModel"},
        "config": {"$ref": "#/definitions/stringMap", "description": "Adapter settings; every value must be a string."},
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "description": "Reference to a secret by environment variable or file; never the secret itself.",
          "properties": {
            "env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "file": {"type": "string", "pattern": "^/"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"adapter": {"const": "remote"}}},
          "then": {"required": ["config"], "properties": {"config": {"required": ["endpoint"]}}}
        },
        {
          "if": {"properties": {"adapter": {"const": "opensandbox"}}},
          "then": {
            "required": ["config", "trust"],
            "properties": {
              "config": {
                "required": ["apiURL"],
                "properties": {
                  "isolation": {"enum": ["", "container", "microvm"]},
                  "useServerProxy": {"enum": ["true", "false"]},
                  "lineEndings": {"enum": ["kept", "stripped"]},
                  "runtime": {"enum": ["docker", "kubernetes", "fastsandbox"]},
                  "timeoutSeconds": {"type": "string", "pattern": "^[0-9]+$"},
                  "poolCPU": {"type": "string", "pattern": "^[0-9]+$"},
                  "poolMemory": {"type": "string", "pattern": "^[0-9]+(Mi|Gi)$"},
                  "ports": {"enum": ["signed"]},
                  "egress": {"enum": ["none", "public", "allowlist"]},
                  "portScheme": {"enum": ["https", "http"]}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"adapter": {"const": "agent-sandbox"}}},
          "then": {
            "required": ["trust"],
            "properties": {"config": {"properties": {"isolation": {"enum": ["", "container", "microvm"]}}}}
          }
        },
        {
          "if": {"properties": {"adapter": {"const": "cubesandbox"}}},
          "then": {
            "required": ["config", "trust"],
            "properties": {"config": {"required": ["apiURL"], "properties": {"proxyScheme": {"enum": ["https", "http"]}}}}
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {"type": "string", "const": "global"},
        "allowedPools": {"type": "array", "items": {"type": "string"}},
        "deniedPools": {"type": "array", "items": {"type": "string"}},
        "allowedRegions": {"type": "array", "items": {"type": "string"}},
        "external": {"$ref": "#/definitions/externalMode"},
        "externalPools": {"type": "array", "items": {"type": "string"}},
        "strategy": {"$ref": "#/definitions/strategy"},
        "maxCostPerHour": {"type": "number", "minimum": 0},
        "maxQueueSeconds": {"$ref": "#/definitions/nonNegativeInt"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "pool", "env"],
      "properties": {
        "enabled": {"type": "boolean"},
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "region": {"type": "string"},
            "labels": {"$ref": "#/definitions/stringMap"},
            "maxConcurrency": {"$ref": "#/definitions/nonNegativeInt"},
            "costModel": {"$ref": "#/definitions/costModel"},
            "config": {"$ref": "#/definitions/stringMap"}
          }
        },
        "existingSecret": {"type": "string"},
        "existingSecretKey": {"type": "string", "minLength": 1},
        "apiKey": {"type": "string"},
        "env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      }
    },
    "opensandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "apiURL", "trust", "pool", "isolation", "env"],
      "properties": {
        "enabled": {"type": "boolean"},
        "apiURL": {"type": "string", "pattern": "^$|^https?://", "description": "OpenSandbox lifecycle API base URL, ending in /v1. Required when enabled."},
        "trust": {"type": "string", "enum": ["private", "external"], "description": "private if you operate the OpenSandbox server, external if someone else does."},
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "region": {"type": "string"},
            "labels": {"$ref": "#/definitions/stringMap"},
            "maxConcurrency": {"$ref": "#/definitions/nonNegativeInt"},
            "costModel": {"$ref": "#/definitions/costModel"}
          }
        },
        "image": {"type": "string"},
        "templateId": {"type": "string"},
        "isolation": {"type": "string", "enum": ["container", "microvm"]},
        "features": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
        "useServerProxy": {"type": ["boolean", "null"]},
        "lineEndings": {"type": "string", "enum": ["", "kept", "stripped"]},
        "runtime": {"type": "string", "enum": ["", "docker", "kubernetes", "fastsandbox"]},
        "timeoutSeconds": {"type": ["integer", "null"], "minimum": 60},
        "poolCPU": {"type": ["string", "integer"], "pattern": "^([0-9]+)?$", "minimum": 1},
        "poolMemory": {"type": "string", "pattern": "^([0-9]+(Mi|Gi))?$"},
        "ports": {"type": "string", "enum": ["", "signed"]},
        "egress": {"type": "string", "enum": ["", "none", "public", "allowlist"]},
        "egressAllow": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "portScheme": {"type": "string", "enum": ["", "https", "http"]},
        "portURLSeconds": {"type": ["integer", "null"], "minimum": 60},
        "existingSecret": {"type": "string"},
        "existingSecretKey": {"type": "string", "minLength": 1},
        "apiKey": {"type": "string"},
        "env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {"type": "string"},
        "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}}}
      }
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "clusterDomain": {"type": "string", "minLength": 1},
    "commonLabels": {"$ref": "#/definitions/stringMap"},

    "config": {
      "type": "object",
      "description": "Server configuration file. Mirrors the server's strict schema; listen, dataDir, dev, auth and store.dsnEnv are chart-managed.",
      "additionalProperties": false,
      "properties": {
        "publicURL": {"type": "string", "pattern": "^$|^https?://"},
        "store": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"driver": {"type": "string", "enum": ["memory", "postgres"]}}
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "orgQuota": {"$ref": "#/definitions/quota"},
            "projectQuota": {"$ref": "#/definitions/quota"},
            "classification": {"type": "string"},
            "profile": {"type": "string"},
            "template": {"type": "string"},
            "resources": {"$ref": "#/definitions/resources"},
            "ttlSeconds": {"$ref": "#/definitions/nonNegativeInt"},
            "idleTimeoutSeconds": {"$ref": "#/definitions/nonNegativeInt"}
          }
        },
        "classifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "external"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string"},
              "external": {"$ref": "#/definitions/externalMode"}
            }
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "resources"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "resources": {
                "allOf": [
                  {"$ref": "#/definitions/resources"},
                  {"required": ["cpu", "memoryMiB"], "properties": {"cpu": {"minimum": 1}, "memoryMiB": {"minimum": 128}}}
                ]
              },
              "template": {"type": "string"},
              "capabilities": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string"},
              "pools": {"type": "array", "items": {"type": "string"}},
              "images": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
            }
          }
        },
        "pools": {"type": "array", "items": {"$ref": "#/definitions/pool"}},
        "policy": {"$ref": "#/definitions/policy"},
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intervalMs": {"$ref": "#/definitions/nonNegativeInt"},
            "provisionTimeoutSeconds": {"$ref": "#/definitions/nonNegativeInt"},
            "maxAttempts": {"$ref": "#/definitions/nonNegativeInt"},
            "reconcileIntervalSeconds": {"$ref": "#/definitions/nonNegativeInt"}
          }
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestsPerSecond": {"type": "number", "minimum": 0},
            "burst": {"$ref": "#/definitions/nonNegativeInt"}
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {"type": "string", "pattern": "^$|^/var/lib/differently/"},
            "recordCommands": {"type": "boolean"},
            "failClosed": {"type": "boolean"}
          }
        },
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    },

    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "existingSecretKey": {"type": "string", "minLength": 1}
      }
    },

    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {"type": "string"},
        "bootstrapTokenKey": {"type": "string", "minLength": 1},
        "bootstrapToken": {"type": "string", "pattern": "^$|^dly_[0-9a-z]+_[0-9a-z]{24,}$"},
        "keepSecretOnUninstall": {"type": "boolean"}
      }
    },

    "opensandbox": {"$ref": "#/definitions/opensandbox"},

    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daytona": {"$ref": "#/definitions/provider"},
        "freestyle": {"$ref": "#/definitions/provider"}
      }
    },

    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "embedded": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {"$ref": "#/definitions/image"},
            "database": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
            "username": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
            "password": {"type": "string", "pattern": "^$|^[A-Za-z0-9._~-]{16,}$", "description": "URL-safe, at least 16 characters; it is embedded in the DSN."},
            "keepSecretOnUninstall": {"type": "boolean"},
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "size": {"type": "string"},
                "storageClass": {"type": "string"},
                "accessModes": {"type": "array", "items": {"type": "string"}}
              }
            },
            "resources": {"$ref": "#/definitions/k8sObject"},
            "nodeSelector": {"$ref": "#/definitions/stringMap"},
            "tolerations": {"$ref": "#/definitions/k8sList"},
            "affinity": {"$ref": "#/definitions/k8sObject"}
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {"type": "string"},
            "existingSecretKey": {"type": "string", "minLength": 1},
            "url": {"type": "string", "pattern": "^$|^postgres(ql)?://"}
          }
        }
      }
    },

    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"type": "string", "enum": ["auto", "hook", "initContainer"]},
        "backoffLimit": {"$ref": "#/definitions/nonNegativeInt"},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "resources": {"$ref": "#/definitions/k8sObject"}
      }
    },

    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "replicas": {"type": "integer", "minimum": 0},
        "containerPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "preflight": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}}},
        "extraArgs": {"type": "array", "items": {"type": "string"}},
        "extraEnv": {"$ref": "#/definitions/k8sList"},
        "extraEnvFrom": {"$ref": "#/definitions/k8sList"},
        "extraVolumes": {"$ref": "#/definitions/k8sList"},
        "extraVolumeMounts": {"$ref": "#/definitions/k8sList"},
        "resources": {"$ref": "#/definitions/k8sObject"},
        "podSecurityContext": {"$ref": "#/definitions/k8sObject"},
        "securityContext": {"$ref": "#/definitions/k8sObject"},
        "startupProbe": {"$ref": "#/definitions/k8sObject"},
        "livenessProbe": {"$ref": "#/definitions/k8sObject"},
        "readinessProbe": {"$ref": "#/definitions/k8sObject"},
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "maxUnavailable": {"type": ["integer", "string"]},
            "minAvailable": {"type": ["integer", "string"]}
          }
        },
        "defaultTopologySpread": {"type": "boolean"},
        "topologySpreadConstraints": {"$ref": "#/definitions/k8sList"},
        "nodeSelector": {"$ref": "#/definitions/stringMap"},
        "tolerations": {"$ref": "#/definitions/k8sList"},
        "affinity": {"$ref": "#/definitions/k8sObject"},
        "priorityClassName": {"type": "string"},
        "podAnnotations": {"$ref": "#/definitions/stringMap"},
        "podLabels": {"$ref": "#/definitions/stringMap"},
        "terminationGracePeriodSeconds": {"$ref": "#/definitions/nonNegativeInt"},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "annotations": {"$ref": "#/definitions/stringMap"}
          }
        }
      }
    },

    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "hosts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "path": {"type": "string"},
        "pathType": {"type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"]},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "secretName": {"type": "string"},
            "certManager": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clusterIssuer": {"type": "string"},
                "issuer": {"type": "string"}
              }
            }
          }
        }
      }
    },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "automountServiceAccountToken": {"type": "boolean"}
      }
    },

    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "server": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ingressFrom": {"$ref": "#/definitions/k8sList"},
            "metricsFrom": {"$ref": "#/definitions/k8sList"},
            "egress": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "restricted": {"type": "boolean"},
                "databaseCIDRs": {"type": "array", "items": {"type": "string"}},
                "databasePort": {"type": "integer", "minimum": 1, "maximum": 65535},
                "providerCIDRs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                "runtimeProviders": {"type": "boolean"},
                "opensandbox": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "namespaceSelector": {"$ref": "#/definitions/k8sObject"},
                    "podSelector": {"$ref": "#/definitions/k8sObject"},
                    "cidrs": {"type": "array", "items": {"type": "string"}},
                    "port": {"type": "integer", "minimum": 1, "maximum": 65535}
                  }
                },
                "extra": {"$ref": "#/definitions/k8sList"}
              }
            }
          }
        }
      }
    },

    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {"type": "integer", "minimum": 0, "maximum": 65535},
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"$ref": "#/definitions/stringMap"},
            "interval": {"type": "string"},
            "scrapeTimeout": {"type": "string"}
          }
        }
      }
    },

    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "profile": {"type": "string", "minLength": 1},
        "projectId": {"type": "string", "pattern": "^$|^prj_[0-9a-z]+$"},
        "existingSecret": {"type": "string"},
        "existingSecretKey": {"type": "string", "minLength": 1},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 30}
      }
    }
  }
}
