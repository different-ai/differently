# /etc/differently/agent.env for differently-agent.service.
# Install with mode 0600, owner root: it contains the agent token.

# Control-plane URL the agent registers with (heartbeats go to
# /internal/v1/agents/heartbeat). Use HTTPS when it crosses a network you do
# not control.
DIFFERENTLY_SERVER_URL=https://differently.example.com

# Shared agent token: the server's DIFFERENTLY_AGENT_TOKEN. On Kubernetes:
#   kubectl get secret -n differently <release>-differently-tokens \
#     -o jsonpath='{.data.agent-token}' | base64 -d
DIFFERENTLY_AGENT_TOKEN=

# Firecracker pool this host joins. It must exist in the server config
# (config.pools, adapter: firecracker) or through POST /v1/admin/pools.
DIFFERENTLY_POOL=edge-linux

# Address the agent listens on, and the URL the control plane uses to reach
# it. The control plane must be able to open TCP connections to this URL;
# firewall the port so only the control plane can.
DIFFERENTLY_LISTEN=:9090
DIFFERENTLY_ADVERTISE_URL=http://10.0.0.21:9090

# Unique node name (no ':').
DIFFERENTLY_NODE_NAME=kvm-host-01

DIFFERENTLY_KERNEL=/var/lib/differently/images/vmlinux
DIFFERENTLY_FIRECRACKER=/usr/local/bin/firecracker

# Capacity kept back for the host itself.
DIFFERENTLY_RESERVE_CPU=1
DIFFERENTLY_RESERVE_MEMORY_MIB=2048

# Extra flags, e.g. the jailer:
#   DIFFERENTLY_AGENT_EXTRA_ARGS=--jailer=/usr/local/bin/jailer
#   DIFFERENTLY_DOCTOR_EXTRA_ARGS=--jailer=/usr/local/bin/jailer
DIFFERENTLY_AGENT_EXTRA_ARGS=
DIFFERENTLY_DOCTOR_EXTRA_ARGS=
