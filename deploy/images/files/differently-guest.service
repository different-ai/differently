# Guest agent for Differently microVMs. Listens on vsock port 10000, where the
# node agent connects to run commands and move files. Installed by
# build-rootfs.sh into images that boot with systemd.
[Unit]
Description=Differently guest agent (vsock port 10000)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
Environment=DIFFERENTLY_GUEST_ARGS=
EnvironmentFile=-/etc/default/differently-guest
ExecStart=/usr/local/bin/differently-guest $DIFFERENTLY_GUEST_ARGS
Restart=always
RestartSec=1s

[Install]
WantedBy=sysinit.target
