+// TestImageGCKeepsWhatAPausedSandboxResumesFrom covers the cache every Fastlet
+// on a node shares: the Fastlet collecting has no use count for checkpoints
+// another one wrote or booted, so only what is on disk can rank them.
+func TestImageGCKeepsWhatAPausedSandboxResumesFrom(t *testing.T) {
+	root := t.TempDir()
+	const image = "12345678"
+	base := time.Now().Add(-time.Hour)
+	seed := func(reference string, age int) string {
+		digest := imageKey(reference)
+		dir := filepath.Join(root, imageCacheDir, digest)
+		require.NoError(t, os.MkdirAll(dir, 0o750))
+		require.NoError(t, os.WriteFile(filepath.Join(dir, rootfsImageName), []byte(image), 0o640))
+		modified := base.Add(time.Duration(age) * time.Minute)
+		require.NoError(t, os.Chtimes(dir, modified, modified))
+		return digest
+	}
+	exists := func(digest string) bool {
+		_, err := os.Stat(filepath.Join(root, imageCacheDir, digest))
+		return err == nil
+	}
+
+	template := seed("tpl-desktop", 0)
+	markImageBooted(root, "tpl-desktop")
+	spent := seed(artifacts.CheckpointReference("spent"), 3)
+	markImageBooted(root, artifacts.CheckpointReference("spent"))
+	older := seed(artifacts.CheckpointReference("paused-yesterday"), 1)
+	newest := seed(artifacts.CheckpointReference("paused-just-now"), 2)
+
+	// Marking changed the entries' times: put the ages back.
+	for digest, age := range map[string]int{template: 0, spent: 3} {
+		modified := base.Add(time.Duration(age) * time.Minute)
+		require.NoError(t, os.Chtimes(filepath.Join(root, imageCacheDir, digest), modified, modified))
+	}
+
+	// The collecting Fastlet booted only the template and an old checkpoint.
+	useCount := map[string]int64{template: 1, older: 1}
+
+	// Room for all but one: the spent checkpoint goes, though it is the newest.
+	removed, err := garbageCollectImages(root, 24, useCount)
+	require.NoError(t, err)
+	require.Equal(t, []string{spent}, removed)
+
+	// Room for two: the template outlives a paused checkpoint, and the older
+	// checkpoint goes first although this Fastlet has counted a use of it.
+	removed, err = garbageCollectImages(root, 16, useCount)
+	require.NoError(t, err)
+	require.Equal(t, []string{older}, removed)
+	require.True(t, exists(newest), "the checkpoint a paused Sandbox needs must survive")
+	require.True(t, exists(template), "the template must survive checkpoints")
+}
+
+func TestConfiguredImageCacheLimit(t *testing.T) {
+	t.Setenv(imageCacheLimitEnv, "")
+	require.Equal(t, int64(defaultImageCacheLimitBytes), configuredImageCacheLimit())
+	t.Setenv(imageCacheLimitEnv, "90")
+	require.Equal(t, int64(90<<30), configuredImageCacheLimit())
+	for _, invalid := range []string{"0", "-1", "lots"} {
+		t.Setenv(imageCacheLimitEnv, invalid)
+		require.Equal(t, int64(defaultImageCacheLimitBytes), configuredImageCacheLimit())
+	}
+}
