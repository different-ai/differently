 const defaultImageCacheLimitBytes = 20 << 30
 
+// imageCacheLimitEnv sizes the cache in GiB, for nodes whose images are large
+// or that keep the checkpoints of paused Sandboxes. It counts rootfs bytes
+// only, and a checkpoint's memory snapshot sits beside its rootfs.
+const imageCacheLimitEnv = "FAST_SANDBOX_IMAGE_CACHE_LIMIT_GIB"
+
+// configuredImageCacheLimit returns the limit imageCacheLimitEnv sets, or the
+// default when it is unset or invalid.
+func configuredImageCacheLimit() int64 {
+	value := os.Getenv(imageCacheLimitEnv)
+	if value == "" {
+		return defaultImageCacheLimitBytes
+	}
+	gib, err := strconv.ParseInt(value, 10, 32)
+	if err != nil || gib <= 0 {
+		klog.InfoS("ignoring invalid image cache limit", "env", imageCacheLimitEnv, "value", value)
+		return defaultImageCacheLimitBytes
+	}
+	return gib << 30
+}
+
+// Cache entries are shared by every Fastlet on a node, while the use counts
+// live in one Fastlet's memory, so a boot also leaves a marker in its entry
+// that all of them can read.
+const (
+	// consumedMarkerName marks a checkpoint a Sandbox has resumed from. That
+	// Sandbox's next pause writes a new checkpoint, so this one is spent.
+	consumedMarkerName = ".consumed"
+	// templateMarkerName marks an image Sandboxes are created from.
+	templateMarkerName = ".template"
+)
+
+// markImageBooted records what a boot says about its cache entry.
+func markImageBooted(stateRoot, image string) {
+	marker := templateMarkerName
+	if strings.HasPrefix(image, artifacts.CheckpointReference("")) {
+		marker = consumedMarkerName
+	}
+	path := filepath.Join(stateRoot, imageCacheDir, imageKey(image), marker)
+	if err := os.WriteFile(path, nil, 0o640); err != nil {
+		klog.V(2).InfoS("could not mark cached image", "image", image, "err", err)
+	}
+}
+
+// evictionRank orders unreferenced entries, lowest first: spent checkpoints,
+// then images no boot has marked (above all the checkpoint a paused Sandbox
+// will resume from, which no Sandbox state references), then templates.
+func evictionRank(entryDir string) int {
+	if _, err := os.Stat(filepath.Join(entryDir, consumedMarkerName)); err == nil {
+		return 0
+	}
+	if _, err := os.Stat(filepath.Join(entryDir, templateMarkerName)); err == nil {
+		return 2
+	}
+	return 1
+}
