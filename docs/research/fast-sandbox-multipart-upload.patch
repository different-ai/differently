+// Large artifacts publish as a parallel multipart upload. One streamed PUT
+// keeps the store on a single connection, and with it on one core for its
+// hashing and compression; parts let it use several. Garage took a 4 GiB
+// memory snapshot at about 285 MB/s as one PUT and about 650 MB/s as four
+// parallel 64 MiB parts. Variables so tests can shrink them.
+var (
+	multipartThreshold int64 = 256 << 20
+	multipartPartSize  int64 = 64 << 20
+	multipartWorkers         = 4
+)
+
+// putFileMultipart uploads the file at path as a multipart upload with
+// multipartWorkers parts in flight. Each part is retried on its own like a
+// PUT; an upload that fails is aborted, so the store drops its parts.
+func (c *s3Client) putFileMultipart(ctx context.Context, path, storeKey string, size int64) error {
+	if !c.writable() {
+		return ErrNotWritable
+	}
+	key := storeKey
+	if c.prefix != "" {
+		key = c.prefix + "/" + storeKey
+	}
+	urlString, err := c.objectURL(key)
+	if err != nil {
+		return err
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+
+	var uploadID string
+	err = c.retryWrite(ctx, key, func() error {
+		_, body, err := c.writeOnce(ctx, http.MethodPost, urlString+"?uploads=", nil, 0)
+		if err != nil {
+			return err
+		}
+		var initiated struct {
+			UploadID string `xml:"UploadId"`
+		}
+		if err := xml.Unmarshal(body, &initiated); err != nil || initiated.UploadID == "" {
+			return &httpError{StatusCode: http.StatusBadGateway, Body: "no UploadId in " + string(body)}
+		}
+		uploadID = initiated.UploadID
+		return nil
+	})
+	if err != nil {
+		return fmt.Errorf("PUT %s: start multipart upload: %w", key, err)
+	}
+	upload := "uploadId=" + awsQueryEscape(uploadID)
+
+	parts := int((size + multipartPartSize - 1) / multipartPartSize)
+	etags := make([]string, parts)
+	partCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	var (
+		wg       sync.WaitGroup
+		failOnce sync.Once
+		partErr  error
+	)
+	next := make(chan int)
+	for range min(multipartWorkers, parts) {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := range next {
+				offset := int64(i) * multipartPartSize
+				length := min(multipartPartSize, size-offset)
+				partURL := urlString + "?partNumber=" + strconv.Itoa(i+1) + "&" + upload
+				err := c.retryWrite(partCtx, key, func() error {
+					header, _, err := c.writeOnce(partCtx, http.MethodPut, partURL, io.NewSectionReader(file, offset, length), length)
+					etags[i] = header.Get("ETag")
+					return err
+				})
+				if err != nil {
+					failOnce.Do(func() { partErr = fmt.Errorf("part %d: %w", i+1, err); cancel() })
+				}
+			}
+		}()
+	}
+feed:
+	for i := range parts {
+		select {
+		case next <- i:
+		case <-partCtx.Done():
+			break feed
+		}
+	}
+	close(next)
+	wg.Wait()
+	if partErr == nil {
+		partErr = ctx.Err()
+	}
+	if partErr == nil {
+		var complete bytes.Buffer
+		complete.WriteString("<CompleteMultipartUpload>")
+		for i, etag := range etags {
+			fmt.Fprintf(&complete, "<Part><PartNumber>%d</PartNumber><ETag>", i+1)
+			_ = xml.EscapeText(&complete, []byte(etag))
+			complete.WriteString("</ETag></Part>")
+		}
+		complete.WriteString("</CompleteMultipartUpload>")
+		partErr = c.retryWrite(ctx, key, func() error {
+			_, body, err := c.writeOnce(ctx, http.MethodPost, urlString+"?"+upload, bytes.NewReader(complete.Bytes()), int64(complete.Len()))
+			if err == nil && bytes.Contains(body, []byte("<Error>")) {
+				// S3 may answer 200 and report the failure in the body.
+				return &httpError{StatusCode: http.StatusInternalServerError, Body: string(body)}
+			}
+			return err
+		})
+	}
+	if partErr != nil {
+		abortCtx, cancelAbort := context.WithTimeout(context.WithoutCancel(ctx), 30*time.Second)
+		defer cancelAbort()
+		_, _, _ = c.writeOnce(abortCtx, http.MethodDelete, urlString+"?"+upload, nil, 0)
+		return fmt.Errorf("PUT %s: %w", key, partErr)
+	}
+	return nil
+}
+
+// retryWrite runs one write with put's policy: transport errors and 5xx
+// responses are retried with exponential backoff, 4xx responses are not.
+func (c *s3Client) retryWrite(ctx context.Context, key string, write func() error) error {
+	backoff := c.retryDelay
+	var lastErr error
+	for attempt := 0; attempt <= s3RetryAttempts; attempt++ {
+		if attempt > 0 {
+			select {
+			case <-time.After(backoff):
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+			backoff *= 2
+		}
+		err := write()
+		if err == nil {
+			return nil
+		}
+		var status *httpError
+		if errors.As(err, &status) && status.StatusCode < http.StatusInternalServerError {
+			return err
+		}
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		klog.V(2).InfoS("S3 write attempt failed, retrying", "key", key, "attempt", attempt+1, "err", err)
+		lastErr = err
+	}
+	return lastErr
+}
+
+// writeOnce sends one request signed with the write credential and returns
+// the response headers and its (bounded) body.
+func (c *s3Client) writeOnce(ctx context.Context, method, urlString string, body io.Reader, size int64) (http.Header, []byte, error) {
+	request, err := http.NewRequestWithContext(ctx, method, urlString, body)
+	if err != nil {
+		return nil, nil, err
+	}
+	request.ContentLength = size
+	c.signWrite(request)
+	response, err := c.putHTTP.Do(request)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer response.Body.Close()
+	payload, _ := io.ReadAll(io.LimitReader(response.Body, 1<<20))
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		return response.Header, nil, &httpError{StatusCode: response.StatusCode, Body: string(payload)}
+	}
+	return response.Header, payload, nil
+}
