+package agent
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// fakeMultipartStore serves PUT objects and the multipart calls (initiate,
+// part, complete, abort), recording how many parts were in flight at once.
+type fakeMultipartStore struct {
+	mu       sync.Mutex
+	objects  map[string][]byte
+	parts    map[int][]byte
+	inFlight int
+	peak     int
+	aborted  bool
+	failPart int // respond 400 to this part number
+}
+
+func (s *fakeMultipartStore) handle(w http.ResponseWriter, r *http.Request) {
+	key := strings.Trim(r.URL.Path, "/")
+	query := r.URL.Query()
+	switch {
+	case r.Method == http.MethodPost && query.Has("uploads"):
+		_, _ = w.Write([]byte(`<InitiateMultipartUploadResult><UploadId>up-1</UploadId></InitiateMultipartUploadResult>`))
+	case r.Method == http.MethodPut && query.Get("uploadId") == "up-1":
+		number, _ := strconv.Atoi(query.Get("partNumber"))
+		s.mu.Lock()
+		s.inFlight++
+		s.peak = max(s.peak, s.inFlight)
+		s.mu.Unlock()
+		time.Sleep(20 * time.Millisecond)
+		body, _ := io.ReadAll(r.Body)
+		s.mu.Lock()
+		s.inFlight--
+		fail := number == s.failPart
+		if !fail {
+			s.parts[number] = body
+		}
+		s.mu.Unlock()
+		if fail {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		w.Header().Set("ETag", fmt.Sprintf(`"etag-%d"`, number))
+	case r.Method == http.MethodPost && query.Get("uploadId") == "up-1":
+		body, _ := io.ReadAll(r.Body)
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		numbers := make([]int, 0, len(s.parts))
+		for n := range s.parts {
+			if !bytes.Contains(body, []byte(fmt.Sprintf("<PartNumber>%d</PartNumber><ETag>&#34;etag-%d&#34;</ETag>", n, n))) {
+				w.WriteHeader(http.StatusBadRequest)
+				return
+			}
+			numbers = append(numbers, n)
+		}
+		sort.Ints(numbers)
+		var object []byte
+		for _, n := range numbers {
+			object = append(object, s.parts[n]...)
+		}
+		s.objects[key] = object
+		_, _ = w.Write([]byte(`<CompleteMultipartUploadResult/>`))
+	case r.Method == http.MethodDelete && query.Get("uploadId") == "up-1":
+		s.mu.Lock()
+		s.aborted = true
+		s.mu.Unlock()
+		w.WriteHeader(http.StatusNoContent)
+	case r.Method == http.MethodPut:
+		body, _ := io.ReadAll(r.Body)
+		s.mu.Lock()
+		s.objects[key] = body
+		s.mu.Unlock()
+	default:
+		w.WriteHeader(http.StatusMethodNotAllowed)
+	}
+}
+
+func shrinkMultipart(t *testing.T) {
+	t.Helper()
+	threshold, part, workers := multipartThreshold, multipartPartSize, multipartWorkers
+	multipartThreshold, multipartPartSize, multipartWorkers = 1024, 256, 3
+	t.Cleanup(func() { multipartThreshold, multipartPartSize, multipartWorkers = threshold, part, workers })
+}
+
+// A large artifact goes up as parallel parts and arrives byte-identical;
+// small files keep the single PUT.
+func TestPublishLargeArtifactUploadsPartsInParallel(t *testing.T) {
+	shrinkMultipart(t)
+	store := &fakeMultipartStore{objects: map[string][]byte{}, parts: map[int][]byte{}}
+	server := httptest.NewServer(http.HandlerFunc(store.handle))
+	defer server.Close()
+	client, err := NewClient("s3://bucket/publish", writeCredential(), WithEndpoint(server.URL))
+	require.NoError(t, err)
+	dir := stageArtifactSet(t)
+	rootfs := bytes.Repeat([]byte("0123456789abcdef"), 200) // 3200 bytes: 13 parts of 256
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "rootfs.ext4"), rootfs, 0o644))
+
+	result, err := client.PublishImage(t.Context(), "", "app-v2", dir)
+	require.NoError(t, err)
+	base := strings.TrimSuffix(strings.TrimPrefix(result.ManifestRef, "s3://"), "/manifest.json")
+	require.Equal(t, rootfs, store.objects[base+"/rootfs.ext4"])
+	require.Equal(t, []byte("memory"), store.objects[base+"/memory.snap"], "small files keep the single PUT")
+	require.Len(t, store.parts, 13)
+	require.Greater(t, store.peak, 1, "parts upload in parallel")
+	require.False(t, store.aborted)
+}
+
+// A part the store refuses fails the publish and aborts the upload, so the
+// store does not keep orphaned parts.
+func TestPublishAbortsFailedMultipartUpload(t *testing.T) {
+	shrinkMultipart(t)
+	store := &fakeMultipartStore{objects: map[string][]byte{}, parts: map[int][]byte{}, failPart: 5}
+	server := httptest.NewServer(http.HandlerFunc(store.handle))
+	defer server.Close()
+	client, err := NewClient("s3://bucket/publish", writeCredential(), WithEndpoint(server.URL))
+	require.NoError(t, err)
+	dir := stageArtifactSet(t)
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "rootfs.ext4"), bytes.Repeat([]byte{7}, 3000), 0o644))
+
+	_, err = client.PublishImage(t.Context(), "", "app-v2", dir)
+	require.ErrorContains(t, err, "part 5")
+	require.True(t, store.aborted)
+	for key := range store.objects {
+		require.NotContains(t, key, "rootfs.ext4", "a failed upload is never completed")
+	}
+}
