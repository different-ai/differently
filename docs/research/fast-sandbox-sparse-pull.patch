+package agent
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"fast-sandbox/internal/artifacts"
+)
+
+// A pulled artifact keeps its bytes and digest but leaves its zero runs as
+// holes: the rootfs of a desktop template is mostly unused disk.
+func TestPullImageLeavesZeroRunsSparse(t *testing.T) {
+	store, client, _, _ := publishFixture(t)
+	data := bytes.Repeat([]byte{0xab}, 3*sparseChunk)
+	rootfs := make([]byte, 0, 64*sparseChunk+100)
+	rootfs = append(rootfs, data...)
+	rootfs = append(rootfs, make([]byte, 40*sparseChunk)...)
+	rootfs = append(rootfs, data[:sparseChunk/2]...) // a partly written chunk stays data
+	rootfs = append(rootfs, make([]byte, 20*sparseChunk+100)...)
+	artifacts := map[string][]byte{"rootfs.ext4": rootfs, "vmstate.snap": []byte("vmstate-bytes"), "memory.snap": make([]byte, 8*sparseChunk)}
+	manifestPayload := testManifestFor(t, artifacts)
+	buildDir := sha256Hex(manifestPayload)[:16]
+	for name, content := range artifacts {
+		store.objects[buildDir+"/"+name] = content
+	}
+	store.objects[buildDir+"/manifest.json"] = manifestPayload
+	root := t.TempDir()
+
+	require.NoError(t, (&Client{s3: client}).PullCheckpoint(context.Background(), root, "checkpoint-sparse",
+		"s3://"+testBucket+"/"+testPrefix+"/"+buildDir+"/manifest.json", sha256Hex(manifestPayload)))
+
+	dir := imageDir(root, "checkpoint-sparse")
+	for cacheName, publishName := range map[string]string{"rootfs.img": "rootfs.ext4", "memory.snap": "memory.snap"} {
+		path := filepath.Join(dir, cacheName)
+		content, err := os.ReadFile(path)
+		require.NoError(t, err)
+		require.Equal(t, artifacts[publishName], content, cacheName)
+		var st syscall.Stat_t
+		require.NoError(t, syscall.Stat(path, &st))
+		allocated := st.Blocks * 512
+		if allocated >= int64(len(content))/2 {
+			t.Skipf("%s: %d of %d bytes allocated; this filesystem does not keep holes", cacheName, allocated, len(content))
+		}
+	}
+	complete, err := cacheComplete(dir)
+	require.NoError(t, err)
+	require.True(t, complete, "the sparse files must still verify against the manifest")
+}
+
+// testManifestFor is testManifest with a fixed x86 CPU identity, so the test
+// does not depend on the host it runs on.
+func testManifestFor(t *testing.T, contents map[string][]byte) []byte {
+	t.Helper()
+	files := map[string]artifacts.ManifestFile{}
+	for name, content := range contents {
+		files[name] = artifacts.ManifestFile{SHA256: sha256Hex(content), SizeBytes: int64(len(content))}
+	}
+	payload, err := artifacts.MarshalVMManifest(artifacts.VMManifest{
+		SchemaVersion: artifacts.VMManifestVersion,
+		Runtime:       "firecracker",
+		Machine:       artifacts.VMMachine{VCPUCount: 1, MemoryMiB: 1, RootfsSizeMiB: 1, RootfsDriveID: "rootfs", RootfsDrivePath: "rootfs.img"},
+		Kernel:        artifacts.VMKernel{Version: "6.1.177"},
+		Compatibility: artifacts.SnapshotCompatibility{CPUArch: "x86_64", FirecrackerVersion: "1.16.1", CPUTemplate: artifacts.CPUTemplateNone, Vendor: artifacts.VendorGenuineIntel, CPUFamily: 6, CPUModel: 85, CPUStepping: 7},
+		Lineage:       &artifacts.VMLineage{Image: testImage},
+		Files:         files,
+	})
+	require.NoError(t, err)
+	return payload
+}
+
+func TestCopySparseMatchesSource(t *testing.T) {
+	for _, size := range []int{0, 1, sparseChunk - 1, sparseChunk, sparseChunk + 1, 3<<20 + 17} {
+		src := make([]byte, size)
+		for i := 0; i < size; i += 7919 {
+			src[i] = byte(i)
+		}
+		out, err := os.CreateTemp(t.TempDir(), "sparse")
+		require.NoError(t, err)
+		written, err := copySparse(out, bytes.NewReader(src))
+		require.NoError(t, err)
+		require.Equal(t, int64(size), written)
+		require.NoError(t, out.Close())
+		got, err := os.ReadFile(out.Name())
+		require.NoError(t, err)
+		require.Equal(t, src, got, "size %d", size)
+	}
+}
