+// sparseChunk is the granularity at which copySparse leaves holes: coarse
+// enough that a mostly-written file keeps few extents (reflink clones and
+// SEEK_DATA walks stay cheap), fine enough to drop an ext4 image's free space
+// and a memory snapshot's untouched RAM.
+const sparseChunk = 64 << 10
+
+// copySparse copies src to dst like io.Copy, but seeks over every all-zero
+// sparseChunk instead of writing it, then sets the final size, so zero runs
+// become holes. The file reads back byte-identical. Published root
+// filesystems are sized to their configured disk and memory snapshots to
+// the VM's RAM, mostly zeros: written densely, every sandbox's reflinked
+// rootfs and every checkpoint staged from it is read in full from disk when
+// it is hashed and uploaded. SHA256File and the upload read holes without
+// touching the disk.
+func copySparse(dst *os.File, src io.Reader) (int64, error) {
+	buf := make([]byte, 1<<20)
+	zero := make([]byte, sparseChunk)
+	var written int64
+	for {
+		n, readErr := io.ReadFull(src, buf)
+		for off := 0; off < n; off += sparseChunk {
+			chunk := buf[off:min(off+sparseChunk, n)]
+			if !bytes.Equal(chunk, zero[:len(chunk)]) {
+				if _, err := dst.WriteAt(chunk, written); err != nil {
+					return written, err
+				}
+			}
+			written += int64(len(chunk))
+		}
+		if readErr == io.EOF || readErr == io.ErrUnexpectedEOF {
+			break
+		}
+		if readErr != nil {
+			return written, readErr
+		}
+	}
+	// Holes at the end are not written: the size comes from the truncate.
+	return written, dst.Truncate(written)
+}
+
 // commitManifest writes the downloaded manifest as the pull commit point:
 // its presence with matching files means the pull is complete. The write is
 // atomic so a crash never leaves a half-written manifest.
